<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark background with sophisticated radial gradient vignette -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="50%"
                android:centerY="40%"
                android:startColor="#141B2D"
                android:centerColor="#0B0F19"
                android:endColor="#06090F" />
        </shape>
    </item>

    <!-- Subtle repeating laboratory glassware & bubbles line pattern -->
    <item>
        <bitmap
            android:src="@drawable/bg_pattern_tile"
            android:tileMode="repeat"
            android:dither="true"
            android:alpha="0.85" />
    </item>
</layer-list>
