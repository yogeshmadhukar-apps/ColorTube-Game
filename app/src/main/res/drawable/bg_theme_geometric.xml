<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="450dp"
                android:centerX="50%"
                android:centerY="40%"
                android:startColor="#0F172A"
                android:centerColor="#090D16"
                android:endColor="#04060A" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/bg_pattern_tile"
            android:tileMode="repeat"
            android:dither="true"
            android:alpha="0.45" />
    </item>
</layer-list>
