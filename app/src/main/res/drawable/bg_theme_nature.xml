<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="460dp"
                android:centerX="50%"
                android:centerY="45%"
                android:startColor="#0A231C"
                android:centerColor="#061510"
                android:endColor="#020806" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/bg_pattern_tile"
            android:tileMode="repeat"
            android:dither="true"
            android:alpha="0.50" />
    </item>
</layer-list>
